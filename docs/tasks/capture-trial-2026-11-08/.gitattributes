# 导出的证据索引按报告原字节计算 SHA-256。
*.json text eol=lf
# 保留本次盲测原答的换行，便于按原始 SHA-256 核对。
host/handoff-retest-a0b6d9b5/*/*.md text eol=lf
# 单帧对照保留报告、快照和窗口导出的原始字节，供证据摘要核对。
host/single-frame-scope-8893017141/* -text !eol
# 固定帧 2 的批次对照同样保留三组证据的原始字节。
host/frame-2-batch-ffbdee1077/*/* -text !eol
# 保留复核报告与查询输出的原始换行，便于按 source_sha256 回查。
host/p01-reopen-bc0c0be664/*.json -text !eol whitespace=cr-at-eol
